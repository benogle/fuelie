{
  "name": "fuelie",
  "type": "module",
  "productName": "Fuelie",
  "description": "Data log analyzer for your favorite ECU",
  "version": "0.2.0",
  "main": "main/index.js",
  "homepage": ".",
  "license": "MIT",
  "author": {
    "name": "Ben Ogle",
    "email": "ogle.ben@gmail.com",
    "url": "https://github.com/benogle"
  },
  "dependencies": {
    "ace-builds": "^1.4.12",
    "chroma-js": "^3.1.2",
    "csv-parser": "^3.0.0",
    "detect-csv": "^1.1.0",
    "electron-is-dev": "^3.0.1",
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^8.1.0",
    "lodash": "^4.17.20",
    "prop-types": "^15.7.2",
    "qs": "^6.9.4",
    "react": "^19.1.1",
    "react-ace": "^14.0.1",
    "react-datasheet": "^1.4.8",
    "react-dom": "^19.1.1",
    "styled-components": "^6.1.19",
    "uplot": "^1.6.21",
    "uplot-react": "^1.1.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev": "concurrently -k \"cross-env BROWSER=none npm start\" \"npm:electron\"",
    "electron": "wait-on tcp:3000 && electron-forge start",
    "package": "vite build && electron-forge package",
    "make": "vite build && electron-forge make",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "vitest",
    "test:node": "vitest run --config ./test/node/vitest.config.js",
    "test:node:watch": "vitest watch --config ./test/node/vitest.config.js"
  },
  "browserslist": {
    "production": [
      "last 2 chrome versions"
    ],
    "development": [
      "last 2 chrome versions"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "app-module-path": "^2.2.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-root-import": "^6.6.0",
    "buffer": "^6.0.3",
    "chai": "^5.2.1",
    "chai-as-promised": "^8.0.1",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.0.0",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-config-nicenice": "^4.1.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-jsx": "^11.0.0",
    "eslint-import-resolver-babel-plugin-root-import": "^1.1.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.21.3",
    "eslint-plugin-standard": "^5.0.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.10",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.0",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "resolutions": {
    "styled-components": "^6"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Fuelie",
        "asar": true
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "fuelie"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
